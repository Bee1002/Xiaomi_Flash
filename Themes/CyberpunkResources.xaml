<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="CpBlack">#FF000000</Color>
    <Color x:Key="CpWhite">#FFFFFFFF</Color>
    <Color x:Key="CpDim">#FF8A8A8A</Color>

    <SolidColorBrush x:Key="CpBlackBrush" Color="{StaticResource CpBlack}"/>
    <SolidColorBrush x:Key="CpWhiteBrush" Color="{StaticResource CpWhite}"/>
    <SolidColorBrush x:Key="CpDimBrush" Color="{StaticResource CpDim}"/>

    <FontFamily x:Key="CpFont">Consolas</FontFamily>
    <FontFamily x:Key="CpUiFont">Segoe UI</FontFamily>

    <!-- Ranuras de ventilación (rejilla bajo info del dispositivo) -->
    <VisualBrush x:Key="TechGridPattern" TileMode="Tile" Viewport="0,0,6,4" ViewportUnits="Absolute">
        <VisualBrush.Visual>
            <Grid Width="6" Height="4">
                <Rectangle Fill="#3A3A3A" Width="6" Height="2" VerticalAlignment="Top"/>
            </Grid>
        </VisualBrush.Visual>
    </VisualBrush>

    <!-- Botón base -->
    <Style x:Key="CpButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource CpFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource CpWhiteBrush}"/>
        <Setter Property="Background" Value="{StaticResource CpBlackBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CpWhiteBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FF111111"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource CpDimBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource CpDimBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CpButtonDashed" TargetType="Button" BasedOn="{StaticResource CpButton}">
        <Setter Property="BorderBrush" Value="{StaticResource CpDimBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource CpDimBrush}"/>
    </Style>

    <!-- Controles de ventana -->
    <Style x:Key="CpWinButton" TargetType="Button">
        <Setter Property="Width" Value="42"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="FontFamily" Value="{StaticResource CpUiFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource CpWhiteBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FF1A1A1A"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Título de sección -->
    <Style x:Key="CpSectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CpFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <!-- Marco con esquinas L -->
    <Style x:Key="CpBracketFrame" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid Background="Transparent">
                        <Path Stroke="White" StrokeThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top"
                              Data="M 0,22 L 0,0 L 22,0" IsHitTestVisible="False"/>
                        <Path Stroke="White" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Top"
                              Data="M 0,0 L 22,0 L 22,22" IsHitTestVisible="False"/>
                        <Path Stroke="White" StrokeThickness="1" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                              Data="M 0,0 L 0,22 L 22,22" IsHitTestVisible="False"/>
                        <Path Stroke="White" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                              Data="M 0,22 L 22,22 L 22,0" IsHitTestVisible="False"/>
                        <ContentPresenter Margin="16,14,16,12"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- GroupBox técnico (esquinas recortadas, cabecera flotante) -->
    <Style x:Key="TechnicalGroupBox" TargetType="GroupBox">
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Margin" Value="5"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="{StaticResource CpFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="HeaderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Foreground="White" FontFamily="{StaticResource CpFont}"
                               FontSize="11" FontWeight="Normal"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Grid SnapsToDevicePixels="True">
                        <Grid Margin="0,10,0,0">
                            <Border BorderBrush="White" BorderThickness="1" Background="Black"/>
                            <Path Stroke="White" StrokeThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top"
                                  Margin="8,0,0,0" Data="M 0,12 L 0,0 L 12,0" IsHitTestVisible="False"/>
                            <Path Stroke="White" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Top"
                                  Margin="0,0,8,0" Data="M 0,0 L 12,0 L 12,12" IsHitTestVisible="False"/>
                            <Path Stroke="White" StrokeThickness="1" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                  Margin="8,0,0,0" Data="M 0,0 L 0,12 L 12,12" IsHitTestVisible="False"/>
                            <Path Stroke="White" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                  Margin="0,0,8,0" Data="M 0,12 L 12,12 L 12,0" IsHitTestVisible="False"/>
                            <ContentPresenter Margin="14,18,14,12"/>
                        </Grid>
                        <Border Background="Black" HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="18,2,0,0" Padding="8,0" Height="18">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botón técnico (del mockup generado) -->
    <Style x:Key="TechButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="White"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="15,8"/>
        <Setter Property="FontFamily" Value="{StaticResource CpFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#33FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#66FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource CpDimBrush}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource CpDimBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TechProgressBar" TargetType="ProgressBar">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="White"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border BorderBrush="White" BorderThickness="1" Background="Black"/>
                        <Border x:Name="PART_Track" Margin="2" Background="Transparent">
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="White"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TechDataGridCell" TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#22FFFFFF"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TechDataGridRow" TargetType="DataGridRow">
        <Setter Property="Background" Value="Black"/>
        <Setter Property="Foreground" Value="White"/>
        <Style.Triggers>
            <Trigger Property="AlternationIndex" Value="1">
                <Setter Property="Background" Value="#11000000"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#22FFFFFF"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TechDataGrid" TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#44FFFFFF"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="RowBackground" Value="Black"/>
        <Setter Property="AlternatingRowBackground" Value="#11000000"/>
        <Setter Property="FontFamily" Value="{StaticResource CpFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="RowHeight" Value="26"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="AlternationCount" Value="2"/>
        <Setter Property="CellStyle" Value="{StaticResource TechDataGridCell}"/>
        <Setter Property="RowStyle" Value="{StaticResource TechDataGridRow}"/>
    </Style>

    <Style x:Key="TechDataGridColumnHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#888888"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="5,4"/>
        <Setter Property="FontFamily" Value="{StaticResource CpFont}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <TextBlock Text="{TemplateBinding Content}"
                               Margin="{TemplateBinding Padding}"
                               Foreground="{TemplateBinding Foreground}"
                               FontFamily="{TemplateBinding FontFamily}"
                               FontSize="{TemplateBinding FontSize}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Marco con borde completo (tabla particiones) -->
    <Style x:Key="CpBoxFrame" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border BorderBrush="White" BorderThickness="1" Background="Black" Padding="14,12">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- READ DEVICE INFO - doble borde biselado -->
    <Style x:Key="CpReadInfoButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource CpFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="Black"/>
        <Setter Property="Padding" Value="20,10"/>
        <Setter Property="MinWidth" Value="200"/>
        <Setter Property="MinHeight" Value="48"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid MinWidth="200" MinHeight="48">
                        <Path Stroke="White" StrokeThickness="2" Fill="Transparent" Stretch="Fill"
                              Data="M 10,2 L 188,2 L 196,10 L 196,42 L 188,50 L 10,50 L 2,42 L 2,10 Z"/>
                        <Path Stroke="White" StrokeThickness="1" Fill="Transparent" Margin="5" Stretch="Fill"
                              Data="M 8,2 L 180,2 L 186,8 L 186,38 L 180,44 L 8,44 L 2,38 L 2,8 Z"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FF0A0A0A"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Logo Xiaomi -->
    <Viewbox x:Key="XiaomiLogo" Width="24" Height="24" Stretch="Uniform" Margin="0,0,10,0">
        <Grid Width="24" Height="24">
            <Border CornerRadius="5" BorderBrush="White" BorderThickness="1.5" Background="Transparent"/>
            <TextBlock Text="mi" FontFamily="{StaticResource CpUiFont}" FontSize="10" FontWeight="SemiBold"
                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0"/>
        </Grid>
    </Viewbox>

    <!-- Teléfono HUD + cable USB recto (sin imágenes externas) -->
    <Grid x:Key="DevicePhoneArt" Width="142" Height="258">
        <Grid.RowDefinitions>
            <RowDefinition Height="220"/>
            <RowDefinition Height="38"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
        <Canvas IsHitTestVisible="False">
            <Line X1="0" Y1="35" X2="142" Y2="35" Stroke="White" StrokeThickness="0.5" Opacity="0.12"/>
            <Line X1="0" Y1="110" X2="142" Y2="110" Stroke="White" StrokeThickness="0.5" Opacity="0.25"/>
            <Line X1="0" Y1="185" X2="142" Y2="185" Stroke="White" StrokeThickness="0.5" Opacity="0.12"/>
            <Line X1="35" Y1="0" X2="35" Y2="220" Stroke="White" StrokeThickness="0.5" Opacity="0.12"/>
            <Line X1="107" Y1="0" X2="107" Y2="220" Stroke="White" StrokeThickness="0.5" Opacity="0.12"/>
            <Ellipse Canvas.Left="46" Canvas.Top="85" Width="50" Height="50" Stroke="White" StrokeThickness="0.8"
                     Opacity="0.25" StrokeDashArray="3 3"/>
            <Ellipse Canvas.Left="56" Canvas.Top="95" Width="30" Height="30" Stroke="White" StrokeThickness="0.5" Opacity="0.15"/>
            <Ellipse Canvas.Left="66" Canvas.Top="105" Width="10" Height="10" Stroke="White" StrokeThickness="1" Opacity="0.4"/>
            <Ellipse Canvas.Left="32" Canvas.Top="32" Width="6" Height="6" Fill="White" Opacity="0.4"/>
            <Ellipse Canvas.Left="104" Canvas.Top="32" Width="6" Height="6" Fill="White" Opacity="0.4"/>
            <Ellipse Canvas.Left="32" Canvas.Top="182" Width="6" Height="6" Fill="White" Opacity="0.4"/>
            <Ellipse Canvas.Left="104" Canvas.Top="182" Width="6" Height="6" Fill="White" Opacity="0.4"/>
            <Line X1="5" Y1="95" X2="12" Y2="95" Stroke="White" StrokeThickness="1" Opacity="0.5"/>
            <Line X1="5" Y1="110" X2="16" Y2="110" Stroke="White" StrokeThickness="1.5" Opacity="0.7"/>
            <Line X1="5" Y1="125" X2="12" Y2="125" Stroke="White" StrokeThickness="1" Opacity="0.5"/>
            <Path Stroke="White" StrokeThickness="1.2" Data="M 10,0 L 0,0 L 0,10" Opacity="0.8" Canvas.Left="10" Canvas.Top="5"/>
            <Path Stroke="White" StrokeThickness="1.2" Data="M 0,0 L 10,0 L 10,10" Opacity="0.8" Canvas.Left="122" Canvas.Top="5"/>
            <Path Stroke="White" StrokeThickness="1.2" Data="M 0,0 L 0,10 L 10,10" Opacity="0.8" Canvas.Left="10" Canvas.Top="205"/>
            <Path Stroke="White" StrokeThickness="1.2" Data="M 10,0 L 10,10 L 0,10" Opacity="0.8" Canvas.Left="122" Canvas.Top="205"/>
        </Canvas>
        <Border BorderBrush="White" BorderThickness="1.8" CornerRadius="10" Height="185" Width="92"
                Background="#1A000000" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid>
                <Border BorderBrush="White" BorderThickness="1" Background="Black" CornerRadius="0,0,5,5"
                        Height="10" Width="38" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-1,0,0">
                    <Ellipse Width="3" Height="3" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7"/>
                </Border>
                <Border BorderBrush="White" BorderThickness="0.5" CornerRadius="7" Margin="4" Opacity="0.25"/>
                <Ellipse Width="12" Height="12" Stroke="White" StrokeThickness="0.9"
                         HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14" Opacity="0.7"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                            Margin="0,0,0,6" Opacity="0.4">
                    <Ellipse Width="2" Height="2" Fill="White" Margin="1"/>
                    <Ellipse Width="2" Height="2" Fill="White" Margin="1"/>
                    <Ellipse Width="2" Height="2" Fill="White" Margin="1"/>
                </StackPanel>
            </Grid>
        </Border>
        </Grid>
        <!-- Cable USB: conector rectangular + línea recta (como mockup) -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-3,0,0">
            <Rectangle Width="20" Height="10" Fill="White" Stroke="White" StrokeThickness="0.8"/>
            <Rectangle Width="1.5" Height="28" Fill="White" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>

    <!-- ═══ Estilos futuristas (mockup v2) ═══ -->

    <Style x:Key="FuturisticGroupBox" TargetType="GroupBox">
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Margin" Value="6"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="{StaticResource CpFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="HeaderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Foreground="White" FontFamily="Consolas"
                               FontSize="11" FontWeight="Bold"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Grid SnapsToDevicePixels="True">
                        <Path Data="M 0,0 L 1,0 L 1,0.05 L 0.97,0.08 L 0.97,1 L 0,1 Z"
                              Fill="#000000" Stroke="#555558" StrokeThickness="1" Stretch="Fill"/>
                        <Rectangle HorizontalAlignment="Left" VerticalAlignment="Top" Width="12" Height="2"
                                   Fill="White" Margin="10,-1,0,0"/>
                        <Rectangle HorizontalAlignment="Right" VerticalAlignment="Top" Width="2" Height="12"
                                   Fill="White" Margin="0,20,0,0"/>
                        <Border Background="#000000" BorderBrush="#88FFFFFF" BorderThickness="1"
                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="15,-10,0,0" Padding="8,2">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                        </Border>
                        <ContentPresenter Margin="15,18,15,12"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FuturisticButton" TargetType="Button">
        <Setter Property="Background" Value="#000000"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,10"/>
        <Setter Property="FontFamily" Value="{StaticResource CpFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Rectangle HorizontalAlignment="Left" VerticalAlignment="Top" Width="3" Height="3"
                                   Fill="White" Margin="2,2,0,0" IsHitTestVisible="False"/>
                        <Rectangle HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="3" Height="3"
                                   Fill="White" Margin="0,0,2,2" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#FFFFFF"/>
                            <Setter Property="Foreground" Value="#000000"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.25"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FuturisticComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="#EEEEEE"/>
        <Setter Property="Background" Value="#111111"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="FontFamily" Value="{StaticResource CpFont}"/>
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Style.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="#222222"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#1A1A1A"/>
                <Setter Property="Foreground" Value="#00FF66"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FuturisticComboBox" TargetType="ComboBox">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="#0A0A0A"/>
        <Setter Property="BorderBrush" Value="#FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="FontFamily" Value="{StaticResource CpFont}"/>
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource FuturisticComboBoxItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Name="ToggleButton"
                                      Grid.Column="2"
                                      Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press"
                                      Background="#0A0A0A"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="22"/>
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter Grid.Column="0"
                                                              Margin="{TemplateBinding Padding}"
                                                              VerticalAlignment="Center"
                                                              HorizontalAlignment="Left"/>
                                            <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z"
                                                  Fill="White" HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Name="ContentSite"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          Margin="8,5,28,5"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"/>
                        <Popup Name="Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Slide">
                            <Grid Name="DropDown"
                                  SnapsToDevicePixels="True"
                                  MinWidth="{TemplateBinding ActualWidth}"
                                  MaxHeight="220">
                                <Border Background="#0D0D0D"
                                        BorderBrush="#FFFFFF"
                                        BorderThickness="1"/>
                                <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Grid>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FuturisticCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="#CCCCCC"/>
        <Setter Property="FontFamily" Value="{StaticResource CpFont}"/>
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="FuturisticProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="24"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="#050507"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Rectangle Stroke="#FFFFFF" StrokeThickness="1" Fill="#050507"/>
                        <Border x:Name="PART_Track" Margin="3" ClipToBounds="True">
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FFFFFF" Offset="0"/>
                                        <GradientStop Color="#DDDDDD" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FuturisticDataGridCell" TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#22FFFFFF"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FuturisticDataGridRow" TargetType="DataGridRow">
        <Setter Property="Background" Value="#030304"/>
        <Setter Property="Foreground" Value="White"/>
        <Style.Triggers>
            <Trigger Property="AlternationIndex" Value="1">
                <Setter Property="Background" Value="#0C0C0E"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#1A1A22"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FuturisticDataGrid" TargetType="DataGrid">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="RowBackground" Value="#030304"/>
        <Setter Property="AlternatingRowBackground" Value="#0C0C0E"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#2A2A2E"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#1A1A1C"/>
        <Setter Property="VerticalGridLinesBrush" Value="#1A1A1C"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="FontFamily" Value="{StaticResource CpFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="RowHeight" Value="26"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="AlternationCount" Value="2"/>
        <Setter Property="CellStyle" Value="{StaticResource FuturisticDataGridCell}"/>
        <Setter Property="RowStyle" Value="{StaticResource FuturisticDataGridRow}"/>
    </Style>

    <Style x:Key="FuturisticDataGridHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#111114"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="White"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="FontFamily" Value="{StaticResource CpFont}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>

</ResourceDictionary>
