<UserControl x:Class="Xiaomi_Flash.Ui.DevicePhoneArtControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="142" Height="258">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="220"/>
            <RowDefinition Height="38"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Canvas IsHitTestVisible="False">
                <Line X1="0" Y1="35" X2="142" Y2="35" Stroke="White" StrokeThickness="0.5" Opacity="0.12"/>
                <Line X1="0" Y1="110" X2="142" Y2="110" Stroke="White" StrokeThickness="0.5" Opacity="0.25"/>
                <Line X1="0" Y1="185" X2="142" Y2="185" Stroke="White" StrokeThickness="0.5" Opacity="0.12"/>
                <Line X1="35" Y1="0" X2="35" Y2="220" Stroke="White" StrokeThickness="0.5" Opacity="0.12"/>
                <Line X1="107" Y1="0" X2="107" Y2="220" Stroke="White" StrokeThickness="0.5" Opacity="0.12"/>
                <Ellipse Canvas.Left="46" Canvas.Top="85" Width="50" Height="50" Stroke="White" StrokeThickness="0.8"
                         Opacity="0.25" StrokeDashArray="3 3"/>
                <Ellipse Canvas.Left="56" Canvas.Top="95" Width="30" Height="30" Stroke="White" StrokeThickness="0.5" Opacity="0.15"/>
                <Ellipse Canvas.Left="66" Canvas.Top="105" Width="10" Height="10" Stroke="White" StrokeThickness="1" Opacity="0.4"/>
                <Ellipse Canvas.Left="32" Canvas.Top="32" Width="6" Height="6" Fill="White" Opacity="0.4"/>
                <Ellipse Canvas.Left="104" Canvas.Top="32" Width="6" Height="6" Fill="White" Opacity="0.4"/>
                <Ellipse Canvas.Left="32" Canvas.Top="182" Width="6" Height="6" Fill="White" Opacity="0.4"/>
                <Ellipse Canvas.Left="104" Canvas.Top="182" Width="6" Height="6" Fill="White" Opacity="0.4"/>
                <Line X1="5" Y1="95" X2="12" Y2="95" Stroke="White" StrokeThickness="1" Opacity="0.5"/>
                <Line X1="5" Y1="110" X2="16" Y2="110" Stroke="White" StrokeThickness="1.5" Opacity="0.7"/>
                <Line X1="5" Y1="125" X2="12" Y2="125" Stroke="White" StrokeThickness="1" Opacity="0.5"/>
                <Path Stroke="White" StrokeThickness="1.2" Data="M 10,0 L 0,0 L 0,10" Opacity="0.8" Canvas.Left="10" Canvas.Top="5"/>
                <Path Stroke="White" StrokeThickness="1.2" Data="M 0,0 L 10,0 L 10,10" Opacity="0.8" Canvas.Left="122" Canvas.Top="5"/>
                <Path Stroke="White" StrokeThickness="1.2" Data="M 0,0 L 0,10 L 10,10" Opacity="0.8" Canvas.Left="10" Canvas.Top="205"/>
                <Path Stroke="White" StrokeThickness="1.2" Data="M 10,0 L 10,10 L 0,10" Opacity="0.8" Canvas.Left="122" Canvas.Top="205"/>
            </Canvas>
            <Border BorderBrush="White" BorderThickness="1.8" CornerRadius="10" Height="185" Width="92"
                    Background="#1A000000" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Border BorderBrush="White" BorderThickness="1" Background="Black" CornerRadius="0,0,5,5"
                            Height="10" Width="38" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-1,0,0">
                        <Ellipse Width="3" Height="3" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7"/>
                    </Border>
                    <Border BorderBrush="White" BorderThickness="0.5" CornerRadius="7" Margin="4" Opacity="0.25"/>
                    <Ellipse Width="12" Height="12" Stroke="White" StrokeThickness="0.9"
                             HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14" Opacity="0.7"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                Margin="0,0,0,6" Opacity="0.4">
                        <Ellipse Width="2" Height="2" Fill="White" Margin="1"/>
                        <Ellipse Width="2" Height="2" Fill="White" Margin="1"/>
                        <Ellipse Width="2" Height="2" Fill="White" Margin="1"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <StackPanel x:Name="usbCablePanel" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top"
                    Margin="0,-3,0,0" RenderTransformOrigin="0.5,0">
            <StackPanel.RenderTransform>
                <TranslateTransform x:Name="usbCableTransform" Y="22"/>
            </StackPanel.RenderTransform>
            <Rectangle Width="20" Height="10" Fill="White" Stroke="White" StrokeThickness="0.8"/>
            <Rectangle x:Name="usbCableWire" Width="1.5" Height="28" Fill="White" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
