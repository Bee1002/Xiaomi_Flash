<?xml version="1.0" encoding="utf-8"?>
<!--
  Publicación framework-dependent (carpeta pequeña).
  El PC destino debe tener .NET 8 Desktop Runtime instalado.
  Uso: dotnet publish -p:PublishProfile=FrameworkDependent
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x86</Platform>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PublishProtocol>FileSystem</PublishProtocol>
    <PublishDir>publish\framework-dependent\</PublishDir>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
</Project>
