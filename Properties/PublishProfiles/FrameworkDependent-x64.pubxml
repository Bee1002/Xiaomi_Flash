<?xml version="1.0" encoding="utf-8"?>
<!--
  Publicación framework-dependent x64 (carpeta pequeña, proceso nativo 64-bit).
  El PC destino debe tener .NET 8 Desktop Runtime instalado.
  Uso: dotnet publish -p:PublishProfile=FrameworkDependent-x64
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PublishProtocol>FileSystem</PublishProtocol>
    <PublishDir>publish\framework-dependent-x64\</PublishDir>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
</Project>
