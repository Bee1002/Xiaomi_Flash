<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Publicación para distribución: usar Properties/PublishProfiles/*.pubxml
    (no activar SelfContained aquí — afectaría el flujo normal de build/debug).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <AssemblyName>Xiaomi_Flash</AssemblyName>
    <RootNamespace>Xiaomi_Flash</RootNamespace>
    <Version>2.0.1</Version>
    <AssemblyVersion>2.0.1.0</AssemblyVersion>
    <FileVersion>2.0.1.0</FileVersion>
    <Authors>Xiaomi_Flash Team</Authors>
    <Description>Fastboot flasher for Xiaomi devices</Description>
    <Platforms>x86;x64</Platforms>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <IncludePackageReferencesDuringMarkupCompilation>false</IncludePackageReferencesDuringMarkupCompilation>
  </PropertyGroup>

  <!-- x86: proceso de 32 bits (WOW64 en Windows 64-bit). -->
  <PropertyGroup Condition="'$(Platform)'=='x86'">
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>

  <!-- x64: proceso de 64 bits; fastboot.exe sigue siendo x86 (proceso hijo, no se carga en memoria). -->
  <PropertyGroup Condition="'$(Platform)'=='x64'">
    <PlatformTarget>x64</PlatformTarget>
    <DefineConstants>$(DefineConstants);PLATFORM_X64</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Google.Protobuf">
      <HintPath>$(MSBuildProjectDirectory)\lib\Google.Protobuf.dll</HintPath>
      <Private>true</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="lib\Google.Protobuf.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Google.Protobuf.dll</Link>
    </Content>
  </ItemGroup>

  <Target Name="CopyDesignTimeReferences" BeforeTargets="MarkupCompilePass1">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\lib\Google.Protobuf.dll"
          DestinationFolder="$(IntermediateOutputPath)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(MSBuildProjectDirectory)\lib\Google.Protobuf.dll')" />
  </Target>

  <ItemGroup>
    <Page Update="Themes\CyberpunkResources.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Fonts\PressStart2P-Regular.ttf" />
    <Resource Include="big_icon.png" />
    <Resource Include="icon.ico" />
    <Content Include="icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\xiaomi_codenames.json" />
    <Content Include="Data\xiaomi_codenames.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Platform-tools (x86): mismo fastboot/adb en ambas plataformas — Process.Start, no P/Invoke. -->
  <ItemGroup>
    <Content Include="fastboot.exe">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="AdbWinApi.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="AdbWinUsbApi.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- LZMA: DLL nativa cargada en el proceso de la app; debe coincidir con la arquitectura del build. -->
  <ItemGroup Condition="'$(Platform)'=='x86'">
    <Content Include="liblzma.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup Condition="'$(Platform)'=='x64'">
    <Content Include="liblzma64.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>
