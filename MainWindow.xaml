<Window x:Class="Xiaomi_Flash.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:Xiaomi_Flash.Ui"
        mc:Ignorable="d"
        d:DesignHeight="740" d:DesignWidth="1140"
        Title="XIAOMI FASTBOOT FLASHER v2.0.1 By Xploit"
        Icon="icon.ico"
        Height="740" Width="1140"
        MinHeight="660" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#000000"
        FontFamily="Consolas"
        FontSize="11"
        Foreground="White"
        shell:WindowChrome.IsHitTestVisibleInChrome="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Xiaomi_Flash;component/Themes/CyberpunkResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- Respaldo para diseñador VS si el merge tarda en cargar -->
            <VisualBrush x:Key="TechGridPattern" TileMode="Tile" Viewport="0,0,6,4" ViewportUnits="Absolute">
                <VisualBrush.Visual>
                    <Grid Width="6" Height="4">
                        <Rectangle Fill="#3A3A3A" Width="6" Height="2" VerticalAlignment="Top"/>
                    </Grid>
                </VisualBrush.Visual>
            </VisualBrush>
        </ResourceDictionary>
    </Window.Resources>

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="taskbariteminfo"/>
    </Window.TaskbarItemInfo>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid Margin="2">
        <Path Stroke="White" StrokeThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top"
              Data="M 0,22 L 0,0 L 22,0" IsHitTestVisible="False"/>
        <Path Stroke="White" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Top"
              Data="M 0,0 L 22,0 L 22,22" IsHitTestVisible="False"/>
        <Path Stroke="White" StrokeThickness="1" HorizontalAlignment="Left" VerticalAlignment="Bottom"
              Data="M 0,0 L 0,22 L 22,22" IsHitTestVisible="False"/>
        <Path Stroke="White" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"
              Data="M 0,22 L 22,22 L 22,0" IsHitTestVisible="False"/>

        <TextBlock Text="⬡ ⬡ ⬡ ⬡" FontSize="8" Opacity="0.2" HorizontalAlignment="Right" VerticalAlignment="Top"
                   Margin="0,54,32,0" FontFamily="Segoe UI" IsHitTestVisible="False"/>
        <TextBlock Text="⬡ ⬡ ⬡" FontSize="8" Opacity="0.15" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                   Margin="32,0,0,36" FontFamily="Segoe UI" IsHitTestVisible="False"/>

        <Border BorderBrush="#44FFFFFF" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="#55FFFFFF" BorderThickness="0,0,0,1" Background="#000000"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Margin="14,0,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ContentControl Content="{StaticResource XiaomiLogo}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="XIAOMI FASTBOOT FLASHER v2.0.1 By Xploit"
                                       FontFamily="Segoe UI" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button Style="{StaticResource CpWinButton}" Content="&#x2500;" Click="MinimizeButton_Click"/>
                            <Button Style="{StaticResource CpWinButton}" Content="&#x25A1;" Click="MaximizeButton_Click"/>
                            <Button Style="{StaticResource CpWinButton}" Content="&#x2715;" Click="CloseButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="14,12,14,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="220" MinHeight="180"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="6*"/>
                    </Grid.ColumnDefinitions>

                    <GroupBox Grid.Row="0" Grid.Column="0" Header="[ DEVICE CONNECTION ]"
                              Style="{StaticResource FuturisticGroupBox}" Margin="0" VerticalAlignment="Stretch">
                        <Grid MinHeight="320">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="3*"/>
                            </Grid.ColumnDefinitions>

                            <ui:DevicePhoneArtControl x:Name="ui_device_phone_art" Grid.Row="0" Grid.Column="0"
                                                      HorizontalAlignment="Center" VerticalAlignment="Top"
                                                      Margin="4,10,4,10"/>

                            <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Top" Margin="12,28,4,0">
                                <TextBlock x:Name="ui_device_status" Margin="0,0,0,8" FontSize="11" FontWeight="Bold"
                                           Foreground="White" Text="STATUS: SCANNING..."/>
                                <TextBlock x:Name="ui_device_port" Text="PORT:   [ — ]" Foreground="#888888" Margin="0,0,0,8"/>
                                <TextBlock x:Name="ui_device_details" FontFamily="Consolas" FontSize="10.5"
                                           Foreground="#DDDDDD" LineHeight="17" Margin="0,0,8,4"
                                           Text="Serial              —&#x0a;Model               —&#x0a;Codename            —&#x0a;Storage             —&#x0a;CPU ID              —&#x0a;HW revision         —&#x0a;Secure boot         —&#x0a;Bootloader          —&#x0a;Boot slot           —&#x0a;Anti-rollback       —&#x0a;Firmware            —"/>
                            </StackPanel>

                            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                    BorderBrush="#44FFFFFF" BorderThickness="0,1,0,0"
                                    Margin="0,8,0,0" Padding="0,10,0,4">
                                <StackPanel>
                                    <TextBlock Text="[ MAIN PROGRESS BAR ]" FontSize="10" Foreground="#888888" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="ui_main_progress_text" FontSize="11"
                                               Text="OVERALL FLASH PROGRESS  [----------------------------------] 0%"/>
                                    <ProgressBar x:Name="ui_main_progress_bar" Value="0" Maximum="100"
                                                 Style="{StaticResource FuturisticProgressBar}" Height="0"
                                                 Visibility="Collapsed" Margin="0,6,0,0"/>
                                    <TextBlock x:Name="ui_current_operation" FontSize="10.5" Foreground="#9A9A9A"
                                               Margin="0,8,0,0"
                                               Text="Current Operation: Idle"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </GroupBox>

                    <Grid Grid.Row="0" Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <GroupBox Grid.Row="0" Header="[ PARTITION FLASHING PROGRESS ]"
                                  Style="{StaticResource FuturisticGroupBox}" Margin="0,0,0,10">
                            <Grid>
                                <TextBlock Text="⬡ ⬡ ⬡" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Top"
                                           Margin="0,-14,6,0" Opacity="0.45" FontFamily="Segoe UI"/>
                                <Grid Margin="0,6,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="96"/>
                                            <ColumnDefinition Width="112"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Foreground="#888888" FontSize="10" Text="[ Index ]"/>
                                        <TextBlock Grid.Column="1" Foreground="#888888" FontSize="10" Text="[ Partition Name ]"/>
                                        <TextBlock Grid.Column="2" Foreground="#888888" FontSize="10" Text="[ Size ]"/>
                                        <TextBlock Grid.Column="3" Foreground="#888888" FontSize="10" Text="[ Status ]"/>
                                        <TextBlock Grid.Column="4" Foreground="#888888" FontSize="10" Text="[ Progress ]"/>
                                    </Grid>
                                    <ScrollViewer x:Name="ui_partition_scroll" Grid.Row="1"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl x:Name="ui_partition_table">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,4">
                                                        <Grid.Style>
                                                            <Style TargetType="Grid">
                                                                <Setter Property="TextElement.Foreground" Value="White"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="[ PENDING ]">
                                                                        <Setter Property="TextElement.Foreground"
                                                                                Value="{StaticResource CpDimBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Grid.Style>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="44"/>
                                                            <ColumnDefinition Width="140"/>
                                                            <ColumnDefinition Width="96"/>
                                                            <ColumnDefinition Width="112"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Index}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Size}"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding Status}"/>
                                                        <TextBlock Grid.Column="4" Text="{Binding ProgressStr}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>
                        </GroupBox>

                        <Grid Grid.Row="1" Margin="0,4,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Stretch">
                                <Button x:Name="ui_advanced" Content="[ ADVANCED ]  ∨"
                                        Style="{StaticResource FuturisticButton}" Padding="12,9"
                                        Margin="0,0,8,0" Click="AdvancedButton_Click"/>
                                <Button x:Name="ui_load_firmware" Content="[ LOAD FIRMWARE ]"
                                        Style="{StaticResource FuturisticButton}" Padding="14,9"
                                        Margin="0,0,8,0"/>
                                <Button x:Name="ui_start_flashing" Content="[ START ]"
                                        Style="{StaticResource FuturisticButton}" Padding="14,9"
                                        Margin="0,0,8,0" IsEnabled="False"/>
                                <Button x:Name="ui_stop_flashing" Content="[ STOP ]"
                                        Style="{StaticResource FuturisticButton}" Padding="14,9"
                                        Margin="0,0,8,0" IsEnabled="False" MinWidth="110"/>
                                <Button x:Name="ui_reboot" Content="[ REBOOT ]  ∨"
                                        Style="{StaticResource FuturisticButton}" Padding="14,9"
                                        MinWidth="120" IsEnabled="False" Click="RebootButton_Click"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="Mode:" VerticalAlignment="Center" Foreground="#888888"
                                           FontFamily="Consolas" FontSize="10.5" Margin="0,0,8,0"/>
                                <ComboBox x:Name="ui_flash_method" MinWidth="320" MaxWidth="420"
                                          IsEnabled="False" Style="{StaticResource FuturisticComboBox}"
                                          DisplayMemberPath="DisplayName"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                                <CheckBox x:Name="ui_opt_bypass_anti_rb" Content="Bypass anti_RB"
                                          Style="{StaticResource FuturisticCheckBox}" Margin="0,0,20,0"/>
                                <CheckBox x:Name="ui_opt_autoreboot" Content="Auto reboot"
                                          Style="{StaticResource FuturisticCheckBox}" IsChecked="True"
                                          Margin="0,0,8,0"/>
                                <TextBlock x:Name="ui_autoreboot_note" VerticalAlignment="Center"
                                           Foreground="#666666" FontFamily="Consolas" FontSize="10"
                                           Visibility="Collapsed"
                                           Text="(reboot included in script)"/>
                            </StackPanel>
                            <Border Grid.Row="3" x:Name="ui_advanced_menu" BorderBrush="White" BorderThickness="1"
                                    Background="#000000" Margin="0,6,0,0" Padding="10,8"
                                    HorizontalAlignment="Left" MinWidth="160" Visibility="Collapsed">
                                <StackPanel>
                                    <Button x:Name="ui_advanced_reset_efs" Content="&gt; Reset EFS"
                                            Background="Transparent" Foreground="White" BorderThickness="0"
                                            Padding="4,3" Margin="0,2" HorizontalContentAlignment="Left"
                                            FontFamily="Consolas" FontSize="11" Cursor="Hand"/>
                                    <Button x:Name="ui_advanced_fix_brick" Content="&gt; Fix / Brick"
                                            Background="Transparent" Foreground="White" BorderThickness="0"
                                            Padding="4,3" Margin="0,2" HorizontalContentAlignment="Left"
                                            FontFamily="Consolas" FontSize="11" Cursor="Hand"/>
                                    <Button x:Name="ui_advanced_slot_ab" Content="&gt; Slot A/B"
                                            Background="Transparent" Foreground="White" BorderThickness="0"
                                            Padding="4,3" Margin="0,2" HorizontalContentAlignment="Left"
                                            FontFamily="Consolas" FontSize="11" Cursor="Hand"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="3" x:Name="ui_reboot_menu" BorderBrush="White" BorderThickness="1"
                                    Background="#000000" Margin="0,6,0,0" Padding="10,8"
                                    HorizontalAlignment="Right" MinWidth="160" Visibility="Collapsed">
                                <StackPanel>
                                    <Button x:Name="ui_reboot_system" Content="&gt; System"
                                            Background="Transparent" Foreground="White" BorderThickness="0"
                                            Padding="4,3" Margin="0,2" HorizontalContentAlignment="Left"
                                            FontFamily="Consolas" FontSize="11" Cursor="Hand"/>
                                    <Button x:Name="ui_reboot_fastboot" Content="&gt; Fastboot"
                                            Background="Transparent" Foreground="White" BorderThickness="0"
                                            Padding="4,3" Margin="0,2" HorizontalContentAlignment="Left"
                                            FontFamily="Consolas" FontSize="11" Cursor="Hand"/>
                                    <Button x:Name="ui_reboot_recovery" Content="&gt; Recovery"
                                            Background="Transparent" Foreground="White" BorderThickness="0"
                                            Padding="4,3" Margin="0,2" HorizontalContentAlignment="Left"
                                            FontFamily="Consolas" FontSize="11" Cursor="Hand"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <GroupBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                              Header="[ OPERATIONS LOG / TERMINAL ]"
                              Style="{StaticResource FuturisticGroupBox}" Margin="0,14,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" BorderBrush="#33FFFFFF" BorderThickness="0,0,1,0"
                                    HorizontalAlignment="Right" Width="1"
                                    Margin="0,0,8,0" VerticalAlignment="Stretch"/>
                            <TextBox Grid.Row="0" x:Name="ui_terminal_log"
                                     Background="Transparent" Foreground="White" BorderThickness="0"
                                     IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                     FontFamily="Consolas" FontSize="11"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     Margin="0,0,12,0" Text=""/>
                            <TextBlock Grid.Row="0" Text="✦" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                       Margin="0,0,10,4" Opacity="0.35" IsHitTestVisible="False"/>
                            <TextBlock Grid.Row="1" x:Name="ui_terminal_banner"
                                       FontFamily="Consolas" FontSize="11.5" FontWeight="Bold"
                                       Foreground="#00FF66" Margin="0,10,12,2"
                                       Visibility="Collapsed" TextWrapping="Wrap"/>
                        </Grid>
                    </GroupBox>
                </Grid>

                <!--
                  HOST UI LEGACY (oculto, no eliminado)
                  Este bloque mantiene vivos los controles fastboot/payload del proyecto original para que
                  su code-behind (FastbootDeviceService.Initialize, PayloadUI.init) siga enlazando eventos y ejecutando
                  la lógica fastboot/payload. NO se muestra en la UI v2.

                  Para exponer una función en la interfaz nueva más adelante:
                    1. Reutilizar handlers en Legacy\FastbootUI.cs / Legacy\PayloadUI.cs / Ui\FastbootAdvanced.cs
                    2. Añadir un botón o panel visible en el grid principal de arriba — no borrar estos hosts.

                  Secciones incluidas:
                    • fastboot_devices_page  — selector multi-dispositivo (doble clic para elegir serial)
                    • fastboot_actions_page  — flash/erase manual + particiones lógicas
                    • payload_before_load / payload_after_load — dumper/extractor standalone de Payload.bin
                -->
                <Grid Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed" Width="0" Height="0" IsHitTestVisible="False">
                    <!-- Selector multi-dispositivo: lista de fastboot conectados; doble clic elige cur_serial -->
                    <Grid x:Name="fastboot_devices_page" Visibility="Hidden">
                        <ListView x:Name="fastboot_devices_list"/>
                        <Label Content="hidden"/>
                    </Grid>
                    <!-- Explorador fastboot: getvar, tabla de particiones, flash/erase manual, lógicas create/delete/resize -->
                    <Grid x:Name="fastboot_actions_page" Visibility="Visible">
                        <ListView x:Name="fastboot_info_list"/>
                        <TextBox x:Name="fastboot_partition_name_textbox"/>
                        <ListView x:Name="fastboot_partition_list"/>
                        <GroupBox x:Name="fastboot_single_part_op">
                            <StackPanel>
                                <Button x:Name="fastboot_flash"/>
                                <Button x:Name="fastboot_erase"/>
                                <Button x:Name="fastboot_logical_delete"/>
                                <Button x:Name="fastboot_logical_create"/>
                                <Button x:Name="fastboot_logical_resize"/>
                            </StackPanel>
                        </GroupBox>
                        <CheckBox x:Name="ignore_unknown_part"/>
                        <ProgressBar x:Name="fastboot_progress_bar" Visibility="Hidden"/>
                        <Grid x:Name="fastboot_action_bar" Visibility="Visible">
                            <Button x:Name="fastboot_reboot_d" Content="Reboot to Bootloader"/>
                            <Button x:Name="fastboot_ab_switch" Content="Switch slot A/B"/>
                            <Button x:Name="fastboot_flash_payload"/>
                            <Button x:Name="fastboot_cancel_update"/>
                            <Label x:Name="fastboot_cur_device"/>
                            <Button x:Name="fastboot_remove"/>
                            <Button x:Name="fastboot_reboot_system"/>
                            <Button x:Name="fastboot_reboot_recovery"/>
                        </Grid>
                    </Grid>
                    <!-- Payload Dumper: abrir payload.bin, ver manifiesto, extraer imágenes de partición a disco -->
                    <Grid x:Name="payload_before_load" Visibility="Hidden">
                        <ProgressBar x:Name="payload_opening" Visibility="Hidden"/>
                        <Button x:Name="payload_load_btn"/>
                    </Grid>
                    <Grid x:Name="payload_after_load" Visibility="Visible">
                        <ListView x:Name="payload_info"/>
                        <TextBox x:Name="payload_partition_name_textbox"/>
                        <ListView x:Name="payload_partition_info"/>
                        <Button x:Name="payload_extract"/>
                        <GroupBox x:Name="payload_extract_options">
                            <StackPanel>
                                <CheckBox x:Name="payload_ignore_delta"/>
                                <CheckBox x:Name="payload_ignore_unknown_op"/>
                                <CheckBox x:Name="payload_ignore_check"/>
                            </StackPanel>
                        </GroupBox>
                        <ListView x:Name="payload_dynamic_partition_meta"/>
                        <ProgressBar x:Name="payload_progress" Visibility="Hidden"/>
                        <Grid x:Name="payload_action_bar" Visibility="Visible">
                            <Button x:Name="payload_remove"/>
                            <Label x:Name="payload_cur_open"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
