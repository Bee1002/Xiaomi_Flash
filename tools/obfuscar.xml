<?xml version="1.0" encoding="utf-8"?>
<!--
  Ofusca SOLO Xiaomi_Flash.dll del publish (no el código fuente).
  Rutas InPath/OutPath las sustituye Obfuscate-Publish.ps1 en cada ejecución.

  Estrategia WPF-safe:
  - KeepPublicApi: no renombra tipos/miembros públicos (XAML, bindings, API pública).
  - HidePrivateApi + HideStrings: ofusca lógica internal/private (Engine, Ui, Legacy).
-->
<Obfuscator>
  <Var name="InPath" value="IN_PATH_PLACEHOLDER" />
  <Var name="OutPath" value="OUT_PATH_PLACEHOLDER" />

  <Var name="KeepPublicApi" value="true" />
  <Var name="HidePrivateApi" value="true" />
  <Var name="HideStrings" value="true" />
  <Var name="RenameProperties" value="false" />
  <Var name="RenameFields" value="false" />
  <Var name="RenameEvents" value="false" />
  <Var name="UseUnicodeNames" value="true" />
  <Var name="OptimizeMethods" value="true" />
  <Var name="SuppressIldasm" value="true" />

  <AssemblySearchPath path="$(InPath)" />

  <Module file="$(InPath)\Xiaomi_Flash.dll">
    <!-- Protobuf generado y compresores embebidos: sin renombrar -->
    <SkipNamespace name="ChromeosUpdateEngine" />
    <SkipNamespace name="Ionic.BZip2" />
    <SkipNamespace name="Ionic.Crc" />
    <SkipNamespace name="Xiaomi_Flash.Compression" />
    <SkipNamespace name="Xiaomi_Flash.Properties" />
  </Module>
</Obfuscator>
